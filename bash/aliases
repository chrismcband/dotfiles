#git aliases
alias gco='git checkout'
alias gcm='git commit -v'

function gmm() {
    branch=$(git branch --show-current)
    git checkout main && git pull && git checkout $branch && git merge main && echo 'Merged main'
}

function gso() {
    branch=$(git branch --show-current)
    git branch --set-upstream-to=origin/$branch $branch
    git pull
}

